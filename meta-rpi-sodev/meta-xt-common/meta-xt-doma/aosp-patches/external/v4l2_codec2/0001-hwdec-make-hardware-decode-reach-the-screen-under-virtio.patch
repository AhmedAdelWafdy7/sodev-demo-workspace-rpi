diff --git a/components/DecodeComponent.cpp b/components/DecodeComponent.cpp
index 00880d7..5d0400f 100644
--- a/components/DecodeComponent.cpp
+++ b/components/DecodeComponent.cpp
@@ -355,16 +355,31 @@ void DecodeComponent::queueTask(std::unique_ptr<C2Work> work) {
     work->worklets.front()->output.buffers.clear();
     work->worklets.front()->output.ordinal = work->input.ordinal;
     if (work->input.buffers.empty()) {
-        // Client may queue a work with no input buffer for either it's EOS or empty CSD, otherwise
-        // every work must have one input buffer.
-        if ((work->input.flags & C2FrameData::FLAG_END_OF_STREAM) == 0 &&
-            (work->input.flags & C2FrameData::FLAG_CODEC_CONFIG) == 0) {
-            ALOGE("Invalid work: work with no input buffer should be EOS or CSD.");
-            reportError(C2_BAD_VALUE);
-            return;
-        }
-
-        // Emplace a nullptr to unify the check for work done.
+        // AN EMPTY WORK WITH NO FLAGS IS LEGAL, AND REJECTING IT KILLS THE
+        // WHOLE COMPONENT.
+        //
+        // Upstream requires FLAG_END_OF_STREAM or FLAG_CODEC_CONFIG here and
+        // calls reportError(C2_BAD_VALUE) otherwise. reportError() latches
+        // ComponentState::ERROR, so every later queue() returns C2_BAD_STATE
+        // and the client cannot recover -- one stray empty work takes the
+        // component down for good.
+        //
+        // Codec2 does not promise that an empty work carries a flag. A client
+        // may queue one to move the timeline along without data, and AOSP's own
+        // software decoders accept it and return it with no output. VTS is the
+        // conformance test and does exactly that: DecodeTestEmptyBuffersInserted
+        // inserts a zero-byte frame every 5th frame and an empty CSD every 20th,
+        // and decodeNFrames() pushes no input buffer at all when the size is
+        // zero (buffers.clear() followed by `if (size)`). Frames 5, 10, 15 ...
+        // are therefore empty AND unflagged. Measured on RPi4 2026-09-03:
+        //
+        //   DecodeComponent: Invalid work: work with no input buffer should be
+        //                    EOS or CSD.
+        //   VTS: component->queue(&items) Which is: BAD_STATE
+        //
+        // So take any empty work. The structural checks above (one worklet, at
+        // most one input buffer) still reject a genuinely malformed work, so
+        // nothing is being waved through.
         ALOGV("Got a work with no input buffer! Emplace a nullptr inside.");
         work->input.buffers.emplace_back(nullptr);
     }
@@ -412,8 +427,34 @@ void DecodeComponent::pumpPendingWorks() {
             mIsDraining = true;
         }
 
-        // Directly report the empty CSD work as finished.
-        if (isCSDWork && isEmptyWork) reportWorkIfFinished(bitstreamId);
+        // EVERY EMPTY WORK HAS TO BE REPORTED HERE, NOT ONLY THE CSD ONES.
+        //
+        // An empty work never reaches the decoder, so nothing else will ever
+        // complete it: it would sit in mWorksAtDecoder forever, the client's
+        // C2Work object would never come back, and the client would starve.
+        // That is what VTS reports as "Wait for generating C2Work exceeded
+        // timeout" -- so accepting empty works in queueTask() without this
+        // would have turned one failure signature into another.
+        //
+        // EOS is the exception: its work is completed by onDrainDone() once the
+        // drain started just above finishes, so reporting it here as well would
+        // report the same work twice.
+        //
+        // FLAG_DROP_FRAME is how this file already says "this work produces no
+        // output", and it is what makes isWorkDone() accept the work: that
+        // predicate needs outputReturned || ignoreOutput, and an empty work has
+        // neither an output buffer nor FLAG_CODEC_CONFIG to lean on. The flag
+        // does not reach the client -- reportWorkIfFinished() clears it before
+        // reporting, so the client sees a work with neither flags nor output
+        // buffer, which the C2 framework already reads as "no corresponding
+        // output" and immediately returns to the pool.
+        if (isEmptyWork && !isEOSWork) {
+            auto it = mWorksAtDecoder.find(bitstreamId);
+            if (it != mWorksAtDecoder.end()) {
+                it->second->worklets.front()->output.flags = C2FrameData::FLAG_DROP_FRAME;
+            }
+            reportWorkIfFinished(bitstreamId);
+        }
     }
 }
 
@@ -517,8 +558,41 @@ void DecodeComponent::onOutputFrameReady(std::unique_ptr<VideoFrame> frame) {
     const int32_t bitstreamId = frame->getBitstreamId();
     auto it = mWorksAtDecoder.find(bitstreamId);
     if (it == mWorksAtDecoder.end()) {
-        ALOGE("Work with bitstreamId=%d not found, already abandoned?", bitstreamId);
-        reportError(C2_CORRUPTED);
+        // Drop it. This is not an error.
+        //
+        // flushTask() empties mWorksAtDecoder through reportAbandonedWorks() after
+        // mDecoder->flush(). The decoder's in-flight output still arrives after that
+        // (in this setup DQBUF comes through a virtio-media event, so there is a wide
+        // window for it to cross with STREAMOFF).
+        // So an output frame with no matching work right after a flush is not an
+        // anomaly, it is the expected race.
+        //
+        // Upstream calls reportError(C2_CORRUPTED) here, so a single seek drives
+        // the component into Error and playback stops. Measured sequence
+        // (2026-09-03, looping a local clip = seek-to-0):
+        //   V4L2Decoder: Set state Draining => Idle        <- flush
+        //   CCodecBufferChannel: flushed work; ignored
+        //   V4L2Decoder: Set state Idle => Decoding        <- resumed
+        //   DecodeComponent: Work with bitstreamId=238 not found, already abandoned?
+        //   DecodeComponent: reportError(error=14)         <- first symptom
+        //   DecodeComponent: Could not queue at state: ERROR
+        //   SurfaceUtils: disconnecting from surface
+        //   BufferQueueProducer: dequeueBuffer: BufferQueue has no connected producer
+        //   C2BqBuffer: cannot dequeue buffer -19
+        //   VideoFramePool: Failed to fetch block, err=22
+        // Everything after the report is fallout from it, not the cause.
+        //
+        // There is nothing this side can do about an unknown bitstreamId
+        // (bitstreamId is timestamp.tv_sec, so a driver returning a strange
+        //  timestamp produces the same shape, and even then dropping the frame is
+        //  the only thing that can be done).
+        // Just count them, keeping the first few and every 100th after that.
+        mStaleOutputFrames++;
+        if (mStaleOutputFrames <= 8 || mStaleOutputFrames % 100 == 0) {
+            ALOGW("Dropping output frame with unknown bitstreamId=%d (work already abandoned; "
+                  "%zu so far). Expected right after a flush/seek.",
+                  bitstreamId, mStaleOutputFrames);
+        }
         return;
     }
     C2Work* work = it->second.get();
