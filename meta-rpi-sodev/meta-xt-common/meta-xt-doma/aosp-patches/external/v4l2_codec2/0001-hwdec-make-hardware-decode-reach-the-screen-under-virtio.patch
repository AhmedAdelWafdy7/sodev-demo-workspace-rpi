+    //       return;
+    //   }
+    //
+    // Without this parameter that config fails, so on RPi4 2026-09-03 all 16
+    // Codec2VideoDecDecodeTest cases returned before touching a frame -- and
+    // reported "[ OK ]". 16 of 26 passes were vacuous, checksum verification
+    // included. AOSP's software decoders declare it, which is why VTS exercises
+    // them properly and not this one.
+    //
+    // One value only: the format V4L2Decoder negotiates. With
+    // ro.vendor.v4l2_codec2.prefer_rgba (default true, read with the same
+    // default as preferRgbOutput() in V4L2Decoder.cpp) the decoder asks the
+    // device for AB24 and hands the client RGBA buffers -- this guest's GL
+    // driver has no GL_EXT_YUV_target, so a YUV buffer cannot become a texture
+    // (see kPreferredRgbFourccs there). Otherwise it is YCBCR_420_888.
+    // Advertising anything else would be a format the client acts on and the
+    // decoder does not produce.
+    const uint32_t pixelFormat = static_cast<uint32_t>(
+            property_get_bool("ro.vendor.v4l2_codec2.prefer_rgba", true)
+                    ? HalPixelFormat::RGBA_8888
+                    : HalPixelFormat::YCBCR_420_888);
+    addParameter(
+            DefineParam(mPixelFormat, C2_PARAMKEY_PIXEL_FORMAT)
+                    .withDefault(new C2StreamPixelFormatInfo::output(0u, pixelFormat))
+                    .withFields({C2F(mPixelFormat, value).oneOf({pixelFormat})})
+                    .withSetter(Setter<C2StreamPixelFormatInfo::output>::StrictValueWithNoDeps)
+                    .build());
+
     addParameter(
             DefineParam(mMaxInputSize, C2_PARAMKEY_INPUT_MAX_BUFFER_SIZE)
                     .withDefault(new C2StreamMaxBufferSizeInfo::input(0u, kInputBufferSizeFor1080p))
@@ -425,15 +463,36 @@ c2_status_t DecodeInterface::queryColorAspects(
 }
 
 uint32_t DecodeInterface::getOutputDelay(VideoCodec codec) {
+    // debug.v4l2codec2.output_delay=N (1..16) overrides the H.264/HEVC value below.
+    //
+    // WHY. The output delay is the dominant term of the CAPTURE buffer count:
+    // V4L2DecodeComponent's getMinNumOutputBuffers() is delay + 4 + 3 + 2, so the
+    // default 16 makes 25 buffers. bcm2835-codec itself needs 1. On the RPi4
+    // DomD the 1080p NV12 capture buffer is 3.1 MB (order-10 CMA), 25 of them
+    // are 78 MB against ~45 MB of free CMA, and the allocation starves DomD
+    // (measured 2026-09-05, twice). 16 is the H.264 DPB worst case; the H.264
+    // streams measured in a WebView reordered by 2-4 frames, so a delay of 4
+    // (13 buffers, 40 MB) keeps 1080p inside the CMA budget. A stream that
+    // reorders deeper than the configured delay makes CCodec time out
+    // ("previous call to queue exceeded timeout") instead of stalling silently,
+    // which is the reason this stays a property and not a new default. Read
+    // once per process, when the first component instance asks; a change
+    // takes effect when the service restarts.
+    static const int32_t sOverride = [] {
+        int32_t v = property_get_int32("debug.v4l2codec2.output_delay", 0);
+        if (v < 1 || v > 16) return 0;
+        ALOGI("output_delay override for H.264/HEVC: %d", v);
+        return v;
+    }();
     switch (codec) {
     case VideoCodec::H264:
         // Due to frame reordering an H264 decoder might need multiple additional input frames to be
         // queued before being able to output the associated decoded buffers. We need to tell the
         // codec2 framework that it should not stop queuing new work items until the maximum number
         // of frame reordering is reached, to avoid stalling the decoder.
-        return 16;
+        return sOverride ? sOverride : 16;
     case VideoCodec::HEVC:
-        return 16;
+        return sOverride ? sOverride : 16;
     case VideoCodec::VP8:
         // The decoder might held a few frames as a reference for decoding. Since Android T
         // the Codec2 is more prone to timeout the component if one is not producing frames. This
diff --git a/components/VideoFrame.cpp b/components/VideoFrame.cpp
index b7481ad..9d195f7 100644
--- a/components/VideoFrame.cpp
+++ b/components/VideoFrame.cpp
@@ -7,11 +7,49 @@
 
 #include <v4l2_codec2/components/VideoFrame.h>
 
+#include <drm/drm.h>
+#include <drm/virtgpu_drm.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+
+#include <mutex>
+#include <unordered_map>
+
 #include <C2AllocatorGralloc.h>
 #include <log/log.h>
 
 namespace android {
 
+namespace {
+
+// dmabuf inode -> virtgpu GEM handle on virtgpuFd().
+//
+// A VideoFrame is rebuilt on every fetch (VideoFramePool::getVideoFrameTask()
+// calls VideoFrame::Create()), so holding this on the object would not be a
+// cache. The pool holds at most 25 blocks at a time, so the map is bounded.
+// It is keyed by the inode and not the fd number: an fd number can change
+// through dup, but the same dmabuf has the same inode. Without the cache every
+// lookup costs three ioctls (PRIME_FD_TO_HANDLE, RESOURCE_INFO, GEM_CLOSE);
+// with it, one.
+//
+// Every use of a handle -- the import, RESOURCE_INFO and GEM_CLOSE -- is made
+// under gHandleMutex. The render node and this cache are shared by every
+// decoder in the process, and clearHandleCache() closes every handle in it, so
+// a handle used outside the lock could be closed, and its number reused for
+// another buffer, before the ioctl that uses it.
+//
+// A dmabuf's inode number is unique for the life of the kernel, so an entry
+// never names another buffer. But each cached handle holds a reference to its
+// buffer, so clearHandleCache() is called whenever a pool is torn down on
+// stream stop / DRC, and the freed pool's buffers go with it.
+std::mutex gHandleMutex;
+std::unordered_map<ino_t, uint32_t> gHandleCache;
+
+}  // namespace
+
 // static
 std::unique_ptr<VideoFrame> VideoFrame::Create(std::shared_ptr<C2GraphicBlock> block) {
     if (!block) return nullptr;
@@ -34,6 +72,93 @@ const std::vector<int>& VideoFrame::getFDs() const {
     return mFds;
 }
 
+namespace {
+
+// The virtio-gpu render node. One fd per process is enough.
+int virtgpuFd() {
+    static const int sFd = []() -> int {
+        const int fd = ::open("/dev/dri/renderD128", O_RDWR | O_CLOEXEC);
+        if (fd < 0) {
+            ALOGE("open(/dev/dri/renderD128) failed: %s", strerror(errno));
+        }
+        return fd;
+    }();
+    return sFd;
+}
+
+// Return the virtgpu GEM handle for a dmabuf fd (cached). Call with
+// gHandleMutex held. Returns false on failure.
+bool handleForFdLocked(int drmFd, int fd, uint32_t* out) {
+    struct stat st = {};
+    const bool haveIno = (fstat(fd, &st) == 0);
+
+    if (haveIno) {
+        const auto it = gHandleCache.find(st.st_ino);
+        if (it != gHandleCache.end()) {
+            *out = it->second;
+            return true;
+        }
+    }
+
+    struct drm_prime_handle prime = {};
+    prime.fd = fd;
+    if (ioctl(drmFd, DRM_IOCTL_PRIME_FD_TO_HANDLE, &prime) != 0) {
+        static bool warned = false;
+        if (!warned) {
+            warned = true;
+            ALOGE("PRIME_FD_TO_HANDLE(fd=%d) failed: %s", fd, strerror(errno));
+        }
+        return false;
+    }
+    *out = prime.handle;
+    if (haveIno) {
+        gHandleCache.emplace(st.st_ino, prime.handle);
+    }
+    return true;
+}
+
+}  // namespace
+
+uint32_t VideoFrame::virglResourceId() {
+    const int drmFd = virtgpuFd();
+    if (drmFd < 0 || mFds.empty()) return 0;
+
+    std::lock_guard<std::mutex> lock(gHandleMutex);
+    uint32_t handle = 0;
+    if (!handleForFdLocked(drmFd, mFds[0], &handle)) return 0;
+
+    struct drm_virtgpu_resource_info info = {};
+    info.bo_handle = handle;
+    if (ioctl(drmFd, DRM_IOCTL_VIRTGPU_RESOURCE_INFO, &info) != 0) {
+        static bool warned = false;
+        if (!warned) {
+            warned = true;
+            ALOGE("%s(): RESOURCE_INFO(handle=%u) failed: %s", __func__, handle,
+                  strerror(errno));
+        }
+        return 0;
+    }
+    return info.res_handle;
+}
+
+// static
+void VideoFrame::clearHandleCache() {
+    const int drmFd = virtgpuFd();
+    std::lock_guard<std::mutex> lock(gHandleMutex);
+    if (drmFd >= 0) {
+        for (const auto& [ino, handle] : gHandleCache) {
+            (void)ino;
+            struct drm_gem_close close_req = {};
+            close_req.handle = handle;
+            ioctl(drmFd, DRM_IOCTL_GEM_CLOSE, &close_req);
+        }
+    }
+    if (!gHandleCache.empty()) {
+        ALOGI("%s(): released %zu cached virtgpu handle(s)", __func__, gHandleCache.size());
+    }
+    gHandleCache.clear();
+}
+
 void VideoFrame::setVisibleRect(const Rect& visibleRect) {
     mVisibleRect = visibleRect;
 }
diff --git a/components/VideoFramePool.cpp b/components/VideoFramePool.cpp
index 9927acf..85fd7f1 100644
--- a/components/VideoFramePool.cpp
+++ b/components/VideoFramePool.cpp
@@ -48,6 +48,49 @@ std::optional<uint32_t> VideoFramePool::getBufferIdFromGraphicBlock(C2BlockPool&
     case V4L2AllocatorId::SECURE_LINEAR: {
         std::shared_ptr<_C2BlockPoolData> blockPoolData =
                 _C2BlockFactory::GetGraphicBlockPoolData(block);
+        // GetGraphicBlockPoolData() RETURNS nullptr FOR A BLOCK THAT CARRIES
+        // NO POOL DATA, AND UPSTREAM'S getType() BELOW DEREFERENCES IT BLIND.
+        //
+        // The branch already knows this block might not be bufferpool-backed --
+        // that is exactly what the next check reports -- but a block with no
+        // pool data at all reaches the same place and segfaults instead.
+        //
+        // Measured on RPi4 2026-09-03, the first time a decode got as far as
+        // allocating real output buffers (once SOURCE_CHANGE reached the guest
+        // and the DRC reordering let S_FMT through):
+        //
+        //   Need 25 output buffers. coded size: 176x144
+        //   (CAPTURE_MPLANE)Queue 9: got 25 buffers
+        //   F DEBUG: tid ... name: VideoFramePoolF
+        //   signal 11 (SIGSEGV), code 1 (SEGV_MAPERR)
+        //   #00 VideoFramePool::getBufferIdFromGraphicBlock(...)+208
+        //   #01 VideoFramePool::getVideoFrameTask()+512
+        if (!blockPoolData) {
+            // FALL BACK TO THE DMABUF'S OWN IDENTITY RATHER THAN GIVING UP.
+            //
+            // A block from a plain C2BasicGraphicBlockPool carries no pool
+            // data, and its allocator id is still GRALLOC, so it lands here.
+            // That is not an error case -- it is what a client which never
+            // called createBlockPool() hands the component, and VTS's
+            // non-surface mode is exactly that client. Refusing it makes
+            // every VTS video-decode test unrunnable while real playback
+            // (which goes through BUFFERQUEUE) works, so the decoder looks
+            // broken in the one place it is measured.
+            //
+            // All this id has to be is a stable per-buffer identity: it keys
+            // mBlockIdToV4L2Id and mFrameAtDevice in V4L2Decoder. The dmabuf
+            // inode is exactly that, and the BUFFERQUEUE branch above already
+            // uses it for the same purpose.
+            auto dmabufId = android::getDmabufId(block.handle()->data[0]);
+            if (!dmabufId) {
+                ALOGE("Obtained C2GraphicBlock has neither pool data nor a "
+                      "usable dmabuf id.");
+                return std::nullopt;
+            }
+            ALOGV("%s(): no pool data; using dmabuf id %u", __func__,
+                  static_cast<uint32_t>(*dmabufId));
+            return dmabufId.value();
