+        // the early return below would skip this entirely.
+        handleHfpScoInputAdded(addedDevices);
         List<AudioDeviceInfo> devices = filterBusDevices(addedDevices);
 
         if (devices.isEmpty()) {
@@ -4421,6 +4435,8 @@ public final class CarAudioService extends ICarAudio.Stub implements CarServiceB
             }
         }
