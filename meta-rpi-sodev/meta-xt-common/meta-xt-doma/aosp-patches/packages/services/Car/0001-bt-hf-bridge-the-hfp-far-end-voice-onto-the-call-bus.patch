@@ -4381,6 +4390,11 @@ public final class CarAudioService extends ICarAudio.Stub implements CarServiceB
             }
         }
         Slogf.d(TAG, "Added audio devices " + Arrays.toString(addedDevices));
+        // Must run BEFORE the filterBusDevices() result is checked: filterBusDevices() is a pure
