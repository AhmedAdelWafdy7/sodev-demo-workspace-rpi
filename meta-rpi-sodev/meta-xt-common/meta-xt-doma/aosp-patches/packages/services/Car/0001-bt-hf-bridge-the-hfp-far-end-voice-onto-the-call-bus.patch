+        // Same ordering note as in audioDevicesAdded(): the early return below would skip this.
+        handleHfpScoInputRemoved(removedDevices);
         List<AudioDeviceInfo> devices = filterBusDevices(removedDevices);
 
         if (devices.isEmpty()) {
@@ -4492,6 +4508,118 @@ public final class CarAudioService extends ICarAudio.Stub implements CarServiceB
         mConfigsCallbacks.finishBroadcast();
     }
 
+    /**
+     * Bridge the HFP far-end audio (the remote party's voice) onto the call bus.
+     *
+     * WHY THIS EXISTS. When the head unit is the hands-free unit (HFP client), the remote
+     * party's voice arrives as an INPUT device, AUDIO_DEVICE_IN_BLUETOOTH_SCO_HEADSET, and
+     * nothing in the platform moves it to a speaker:
+     *  - AudioPolicyManager does have an automatic call bridge
+     *    (AudioPolicyManager.cpp:774 updateCallRouting -> :892 connectTelephonyRxAudioSource)
+     *    but its source is hard-coded to AUDIO_DEVICE_IN_TELEPHONY_RX (:922-925), and this
+     *    product declares no TELEPHONY port at all, so it never applies.
+     *  - The BT audio HAL's input stream is reader-driven: audio_bluetooth_hw's in_read()
+     *    is what eventually makes the Bluetooth stack activate the HFP decode session, so
+     *    with no reader the far-end PCM is dropped inside the stack.
+     * So a patch has to be created explicitly, and it has to be created HERE rather than
+     * with HwAudioSource/AudioSystem.startAudioSource: those resolve their sink through the
+     * default audio policy engine, whose phone strategy cannot pick an AUDIO_DEVICE_OUT_BUS
+     * at all, so they would land on the media bus. createAudioPatchLocked() resolves the
+     * sink through getOutputDeviceForAudioAttributeLocked(), i.e. through the CAR zone
+     * configuration, which maps USAGE_VOICE_COMMUNICATION -> CALL context -> the call bus.
+     *
+     * WHY THE INTERNAL CALL IS ALLOWED. createAudioPatchLocked() itself performs no
+     * enforcement; the public createAudioPatch() is what calls enforceCanUseAudioPatchAPI(),
+     * so the ro.android.car.audio.enableaudiopatch gate stays untouched for external
+     * callers and does not need to be turned on for this. The permission check inside
+     * getOutputDeviceForAudioAttributeLocked() uses checkCallingOrSelfPermission(), and
+     * car service runs with sharedUserId android.uid.system, which
+     * ActivityManager.canAccessUnexportedComponents() grants unconditionally.
+     *
+     * Failures are logged and swallowed on purpose: a call that cannot be bridged must not
+     * take the audio device callback -- and with it every zone update -- down with it.
+     */
+    private void handleHfpScoInputAdded(AudioDeviceInfo[] addedDevices) {
+        AudioDeviceInfo scoMic = findHfpScoInput(addedDevices);
+        if (scoMic == null) {
+            return;
+        }
+        synchronized (mImplLock) {
+            if (mHfpScoPatch != null) {
+                Slogf.i(TAG, "HFP SCO input already bridged, leaving %s alone", mHfpScoPatch);
+                return;
+            }
+            try {
+                mHfpScoPatch = createAudioPatchLocked(scoMic.getAddress(),
+                        AudioAttributes.USAGE_VOICE_COMMUNICATION, /* gainInMillibels= */ 0);
+                Slogf.i(TAG, "Bridged HFP SCO input %s onto the call bus: %s",
+                        scoMic.getAddress(), mHfpScoPatch);
+            } catch (RuntimeException e) {
+                Slogf.e(TAG, e, "Could not bridge HFP SCO input %s onto the call bus",
+                        scoMic.getAddress());
+                mHfpScoPatch = null;
+            }
+        }
+    }
+
+    /** Undo {@link #handleHfpScoInputAdded}; leaving the patch would double up on the next call. */
+    private void handleHfpScoInputRemoved(AudioDeviceInfo[] removedDevices) {
+        if (findHfpScoInput(removedDevices) == null) {
+            return;
+        }
+        synchronized (mImplLock) {
+            if (mHfpScoPatch == null) {
+                return;
+            }
+            try {
+                releaseAudioPatchLocked(mHfpScoPatch);
+                Slogf.i(TAG, "Released the HFP SCO bridge");
+            } catch (RuntimeException e) {
+                Slogf.e(TAG, e, "Could not release the HFP SCO bridge");
+            }
+            mHfpScoPatch = null;
+        }
+    }
+
+    /**
+     * Drop the HFP bridge when car audio service tears its callbacks down.
+     *
+     * Without this the handle survives an audio server restart and permanently blocks the
+     * bridge: audioDevicesRemoved() returns early while mIsAudioServerDown is set, so the
+     * release never runs, and on recovery AudioManager re-delivers every current device to
+     * onAudioDevicesAdded() -- where handleHfpScoInputAdded() would find mHfpScoPatch still
+     * set and log "already bridged, leaving alone" for every call from then on.
+     *
+     * When the audio server is down the patch is already gone with it, so only the handle is
+     * cleared; otherwise it is released properly first.
+     */
+    @GuardedBy("mImplLock")
+    private void releaseHfpScoPatchLocked(boolean isAudioServerDown) {
+        if (mHfpScoPatch == null) {
+            return;
+        }
+        if (!isAudioServerDown) {
+            try {
+                releaseAudioPatchLocked(mHfpScoPatch);
+            } catch (RuntimeException e) {
+                Slogf.e(TAG, e, "Could not release the HFP SCO bridge while tearing down");
+            }
+        } else {
+            Slogf.i(TAG, "Audio server is down, dropping the HFP SCO bridge handle");
+        }
+        mHfpScoPatch = null;
+    }
+
+    @Nullable
+    private static AudioDeviceInfo findHfpScoInput(AudioDeviceInfo[] devices) {
+        for (AudioDeviceInfo info : devices) {
+            if (info.isSource() && info.getType() == AudioDeviceInfo.TYPE_BLUETOOTH_SCO) {
+                return info;
+            }
+        }
+        return null;
+    }
+
     private static List<AudioDeviceInfo> filterBusDevices(AudioDeviceInfo[] infos) {
         List<AudioDeviceInfo> devices = new ArrayList<>();
         for (int c = 0; c < infos.length; c++) {
