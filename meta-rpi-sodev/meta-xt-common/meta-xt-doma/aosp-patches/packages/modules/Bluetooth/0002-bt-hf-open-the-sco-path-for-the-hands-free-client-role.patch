diff --git a/android/app/src/com/android/bluetooth/hfpclient/HeadsetClientStateMachine.java b/android/app/src/com/android/bluetooth/hfpclient/HeadsetClientStateMachine.java
index 1567a9b..343bbce 100644
--- a/android/app/src/com/android/bluetooth/hfpclient/HeadsetClientStateMachine.java
+++ b/android/app/src/com/android/bluetooth/hfpclient/HeadsetClientStateMachine.java
@@ -54,6 +54,7 @@ import android.content.Intent;
 import android.media.AudioAttributes;
 import android.media.AudioFocusRequest;
 import android.media.AudioManager;
+import android.media.BluetoothProfileConnectionInfo;
 import android.os.Bundle;
 import android.os.Looper;
 import android.os.Message;
@@ -934,12 +935,74 @@ public class HeadsetClientStateMachine extends StateMachine {
         debug("hfp_enable=" + enable);
         if (enable && !sAudioIsRouted) {
             mAudioManager.setHfpEnabled(true);
+            notifyAudioFrameworkScoActiveDevice(mDevice, null);
         } else if (!enable) {
             mAudioManager.setHfpEnabled(false);
+            notifyAudioFrameworkScoActiveDevice(null, mDevice);
         }
         sAudioIsRouted = enable;
     }
 
+    /**
+     * Tell the audio framework which device owns the SCO link, the way the AG role already does
+     * (HeadsetService.java:1113-1120 and :1199-1205).
+     *
+     * WHY THIS IS NEEDED. setHfpEnabled() above is only
+     * AudioSystem.setParameters("hfp_enable=...") (AudioManager.java:4075-4077) -- a string to
+     * the audio HAL. It registers no device. Without a registration the SCO ports declared in
+     * bluetooth_audio_policy_configuration.xml never become available, so nothing can open the
+     * `hfp input` stream, so audio_bluetooth_hw/stream_apis.cc:1064 in_read() never runs, so
+     * BluetoothAudioPortAidl::Start (device_port_proxy.cc:516) never calls StartStream (:528),
+     * so HfpTransport::StartRequest() is never reached -- and the far-end PCM is dropped by
+     * audio_hal_interface/hfp_client_interface.cc:200-205, which returns len as if it had
+     * written everything. The whole chain is reader-driven; this call is its first link.
+     * Measured on the board 2026-09-13 across the three SCO stages.
+     *
+     * WHY THE AG API IS THE RIGHT ONE FOR THE HF ROLE.
+     *  - createHfpInfo() reports BluetoothProfile.HEADSET
+     *    (BluetoothProfileConnectionInfo.java:188-191), and that is exactly the profile
+     *    AudioService.handleBluetoothActiveDeviceChanged accepts while isScoManagedByAudio()
+     *    is true (AudioService.java:9659-9666). HEADSET_CLIENT would be rejected there.
+     *  - AudioDeviceInventory.java:1067-1076 then calls
+     *    AudioDeviceBroker.onSetBtScoActiveDevice() WITHOUT needing the AG profile proxy, and
+     *    BtHelper.java:1403 / :1426 register the SCO output and the SCO INPUT
+     *    (DEVICE_IN_BLUETOOTH_SCO_HEADSET -- the only place in the tree that does).
+     *  - BLUETOOTH_STACK is required (AudioManager.java:7420-7422) and this app already holds
+     *    it (android/app/AndroidManifest.xml:38); hfp/ and hfpclient/ are the same app.
+     *
+     * WHY IT IS SAFE WITH THE AG PROFILE DISABLED (this product: no
+     * bluetooth.profile.hfp.ag.enabled, so HeadsetService.isEnabled() is false):
+     * BtHelper.mScoHelper is only created in onHeadsetProfileConnected (BtHelper.java:1305) and
+     * therefore stays null, and both BtHelper.startBluetoothSco (:749-757) and
+     * stopBluetoothSco (:759-767) null-check it and return false. Under
+     * bluetooth.sco.managed_by_audio the AmScoHelper would not establish SCO anyway -- its own
+     * class comment says start/stop "doesn't actually start or stop SCO" -- so the HF stack
+     * keeps owning SCO establishment and nothing here fights it.
+     *
+     * Repeated calls are harmless: BtHelper.onSetBtScoActiveDevice returns early when the
+     * device is unchanged (BtHelper.java:1451-1453).
+     */
+    private void notifyAudioFrameworkScoActiveDevice(
+            BluetoothDevice newDevice, BluetoothDevice previousDevice) {
+        // Guard the flagged API the same way the AG role does
+        // (hfp/HeadsetSystemInterface.java:389-397): AudioManager.isScoManagedByAudio() is
+        // @FlaggedApi(FLAG_AMSCO_AVAILABLE_API) (AudioManager.java:10421), so it disappears from
+        // the stubs in a build where that flag is off and referencing it unguarded breaks the
+        // build there.
+        // TODO(b/437953494) Replace with an SDK check when the flag is fully rolled out.
+        if (!android.media.audio.Flags.amscoAvailableApi()) {
+            debug("notifyAudioFrameworkScoActiveDevice: amsco api not available, skipping");
+            return;
+        }
+        if (!mAudioManager.isScoManagedByAudio()) {
+            debug("notifyAudioFrameworkScoActiveDevice: sco not managed by audio, skipping");
+            return;
+        }
+        debug("notifyAudioFrameworkScoActiveDevice: " + previousDevice + " -> " + newDevice);
+        mAudioManager.handleBluetoothActiveDeviceChanged(
+                newDevice, previousDevice, BluetoothProfileConnectionInfo.createHfpInfo());
+    }
+
     private AudioFocusRequest requestAudioFocus() {
         AudioAttributes streamAttributes =
                 new AudioAttributes.Builder()
diff --git a/system/audio_bluetooth_hw/device_port_proxy.cc b/system/audio_bluetooth_hw/device_port_proxy.cc
index 57c205e..f9d5f57 100644
--- a/system/audio_bluetooth_hw/device_port_proxy.cc
+++ b/system/audio_bluetooth_hw/device_port_proxy.cc
@@ -202,6 +202,54 @@ bool BluetoothAudioPortAidl::init_session_type(audio_devices_t device) {
                    << StringPrintf("%#x", device) << ")";
       session_type_ = SessionType::A2DP_SOFTWARE_ENCODING_DATAPATH;
       break;
+    case AUDIO_DEVICE_OUT_BLUETOOTH_SCO:
+    case AUDIO_DEVICE_OUT_BLUETOOTH_SCO_HEADSET:
+    case AUDIO_DEVICE_OUT_BLUETOOTH_SCO_CARKIT:
+      /* HFP. Upstream this module has no SCO mapping at all, so the HF-role
+       * software data path in bta/hf_client (measured on the board
+       * 2026-08-27) would have no consumer on the audio side: the stack
+       * could put PCM into an HFP_SOFTWARE_* session, but nothing here
+       * would ever ask for one.
+       *
+       * Everything else in the chain already existed, verified rather than
+       * assumed:
+       *   - SessionType::HFP_SOFTWARE_{ENCODING,DECODING}_DATAPATH are in
+       *     hardware/interfaces/bluetooth/audio/aidl/.../SessionType.aidl:74-80
+       *   - the AIDL default provider implements them:
+       *     aidl/default/HfpSoftwareAudioProvider.{h,cc}, dispatched from
+       *     BluetoothAudioProviderFactory.cpp:88-91
+       *   - bta/hf_client uses exactly these two session types
+       *     (hfp_client_interface.cc:265,434)
+       *
+       * ENCODING for output / DECODING for input, matching the LE Audio cases
+       * below and the stack's own direction convention: the stack READS from
+       * the encode interface to get PCM it will transmit, and WRITES received
+       * PCM into the decode interface.
+       *
+       * NOTE THE AIDL-ONLY CONSTRAINT. stream_apis.cc:737 and :1223 pick
+       * BluetoothAudioPortAidl only when
+       * BluetoothAudioSession::IsAidlAvailable() -- i.e. when the AIDL
+       * IBluetoothAudioProviderFactory/default is running -- and otherwise fall
+       * back to BluetoothAudioPortHidl. HIDL 2.1 has NO HFP session type
+       * (checked: zero HFP/SCO hits in
+       * hardware/interfaces/bluetooth/audio/2.1/types.hal), so SCO can only
+       * work on the AIDL path. The products this is built for install
+       * android.hardware.bluetooth.audio-impl (the AIDL provider), so the
+       * AIDL path is the one taken.
+       * No matching change is made to device_port_proxy_hidl.cc because there
+       * is no session type there to map to.
+       *
+       * Sample rate / format need no special casing: LoadAudioConfig() takes
+       * both from the session's PcmConfiguration, and HFP is 16-bit
+       * (BitsPerSampleToAudioFormat()'s case 16), 8/16/32 kHz mono depending on
+       * the negotiated codec (CVSD/mSBC/LC3). The audio policy XML must declare
+       * matching mix ports -- the product's bluetooth_audio_policy_configuration.xml
+       * does that, and this change alone does not make audio flow.
+       */
+      LOG(VERBOSE) << __func__ << ": device=AUDIO_DEVICE_OUT_BLUETOOTH_SCO (HEADSET/CARKIT) ("
+                   << StringPrintf("%#x", device) << ")";
+      session_type_ = SessionType::HFP_SOFTWARE_ENCODING_DATAPATH;
+      break;
     case AUDIO_DEVICE_OUT_HEARING_AID:
       LOG(VERBOSE) << __func__ << ": device=AUDIO_DEVICE_OUT_HEARING_AID (MEDIA/VOICE) ("
                    << StringPrintf("%#x", device) << ")";
@@ -217,6 +265,12 @@ bool BluetoothAudioPortAidl::init_session_type(audio_devices_t device) {
                    << StringPrintf("%#x", device) << ")";
       session_type_ = SessionType::LE_AUDIO_SOFTWARE_ENCODING_DATAPATH;
       break;
+    case AUDIO_DEVICE_IN_BLUETOOTH_SCO_HEADSET:
+      /* HFP capture. See the OUT_BLUETOOTH_SCO comment above. */
+      LOG(VERBOSE) << __func__ << ": device=AUDIO_DEVICE_IN_BLUETOOTH_SCO_HEADSET (VOICE) ("
+                   << StringPrintf("%#x", device) << ")";
+      session_type_ = SessionType::HFP_SOFTWARE_DECODING_DATAPATH;
+      break;
     case AUDIO_DEVICE_IN_BLE_HEADSET:
       LOG(VERBOSE) << __func__ << ": device=AUDIO_DEVICE_IN_BLE_HEADSET (VOICE) ("
                    << StringPrintf("%#x", device) << ")";
