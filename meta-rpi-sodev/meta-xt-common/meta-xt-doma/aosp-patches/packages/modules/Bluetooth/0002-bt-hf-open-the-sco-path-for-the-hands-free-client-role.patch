 #include "btif/include/btif_hf.h"
 #include "btif_status.h"
 #include "hardware/bluetooth.h"
@@ -111,6 +112,50 @@ HfpTransport::HfpTransport() {
 }
 
 BluetoothAudioCtrlAck HfpTransport::StartRequest() {
+  /* HF ROLE (this product).  Everything below this block is written for the AG
+   * role: it needs bta_ag_get_active_device(), it asks the stack to bring SCO up
+   * with headset::ConnectAudio(), and it reports progress through
+   * hfp_pending_cmd_.  None of that applies when we are the hands-free unit:
+   *   - the HF role has no active-device concept at all (zero hits for
+   *     active_device under bta/hf_client), so get_hfp_active_device_control_block()
+   *     below returns nullptr and the AG code after this block answers FAILURE;
+   *   - SCO is established by the PEER (the phone), not by us, so there is nothing
+   *     to "connect" here.  By the time the host starts the stream the link is
+   *     already up: the audio framework only learns about the SCO device after
+   *     HeadsetClientStateMachine.routeHfpAudio() reports it, which happens on
+   *     AUDIO_STATE_CONNECTED.
+   * So for HF we only have to answer "yes, a link is up" and activate the stream.
+   * Returning SUCCESS_FINISHED synchronously (like the bta_ag_sco_is_open() path
+   * below) also keeps hfp_pending_cmd_ at HFP_CTRL_CMD_NONE, which is what
+   * HfpClientInterface::Decode::ConfirmStreamingRequest() expects to never see a
+   * dangling START for.
+   *
+   * Without this branch the stream stays inactive and
+   * HfpClientInterface::Decode::Write() drops every far-end packet while
+   * returning len, i.e. silence with no error anywhere.  Measured on the
+   * board 2026-09-13 (HF-client role, SCO open).
+   *
+   * Gated on bta_hf_client_sco_datapath_active() so an AG-only build keeps the
+   * original path untouched.  Note that once that predicate is true this branch
+   * ANSWERS for both outcomes -- it does NOT fall through to the AG code when no HF
+   * link is open, it returns FAILURE.  That is deliberate but only safe because the
+   * predicate cannot be true while the AG owns the software datapath: the singleton
+   * interfaces are taken by whoever initialises first, so if the AG has them
+   * hfp_software_datapath_enabled stays false here (see
+   * bta_hf_client_init_hfp_client_interface in bta/hf_client/bta_hf_client_sco.cc),
+   * and if we have them the AG's software datapath is already inoperative. */
+  if (bta_hf_client_sco_datapath_active()) {
+    RawAddress hf_addr;
+    if (bta_hf_client_sco_get_active_device(&hf_addr)) {
+      log::info("HF role: SCO link is up, activating the decode/encode streams");
+      is_stream_active = true;
+      LogMetricHfpStartStream(hf_addr);
+      return BluetoothAudioCtrlAck::SUCCESS_FINISHED;
+    }
+    log::warn("HF role: no SCO link open yet, not starting the stream");
+    return BluetoothAudioCtrlAck::FAILURE;
+  }
+
   auto cb = get_hfp_active_device_control_block();
   if (cb == nullptr) {
     return BluetoothAudioCtrlAck::FAILURE;
@@ -159,6 +204,19 @@ void HfpTransport::StopRequest() {
 
   is_stream_active = false;
 
+  /* HF ROLE: do NOT tear the link down here.  The AG path below calls
+   * headset::DisconnectAudio(), which is right when WE brought SCO up, but in the
+   * HF role the link belongs to the call: the host merely stopped reading the
+   * stream (e.g. the reader closed), and dropping SCO would cut the call audio.
+   * Deactivating the stream above is the whole job; the peer or
+   * HeadsetClientStateMachine tears SCO down when the call ends, and that path
+   * already reports it through routeHfpAudio(false). */
+  if (bta_hf_client_sco_datapath_active()) {
+    log::info("HF role: stream deactivated, leaving the SCO link to the call");
+    hfp_pending_cmd_ = HFP_CTRL_CMD_NONE;
+    return;
+  }
+
   RawAddress addr = bta_ag_get_active_device();
   if (addr.IsEmpty()) {
     log::error("No active device found");
