From 9b18c3f58f96ecc9e562499b9728d9acb4c9cc5c Mon Sep 17 00:00:00 2001
From: Yuichi Kusakabe <yuichi_kusakabe@jp.honda>
Date: Tue, 22 Sep 2026 17:09:15 +0900
Subject: [PATCH] bt-a: let A2DP take audio focus on a car product

A2DP was selectable and silent: the stack did not request focus for it in this
configuration, so the route never became active.

Assisted-by: Claude Code:claude-opus-5
Signed-off-by: Yuichi Kusakabe <yuichi_kusakabe@jp.honda>
Upstream-Status: Inappropriate [product configuration: flips an AOSP default
 that a product overlay can set]
---
 android/app/res/values/config.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/android/app/res/values/config.xml b/android/app/res/values/config.xml
index 8b58d397ee0..a117d5ab8f1 100644
--- a/android/app/res/values/config.xml
+++ b/android/app/res/values/config.xml
@@ -87,7 +87,7 @@
     <!-- For A2DP sink ducking volume feature. -->
     <integer name="a2dp_sink_duck_percent">25</integer>
     <!-- If true, device requests audio focus and start avrcp updates on source start or play -->
-    <bool name="a2dp_sink_automatically_request_audio_focus">false</bool>
+    <bool name="a2dp_sink_automatically_request_audio_focus">true</bool>
 
     <!-- For enabling browsed cover art with the AVRCP Controller Cover Artwork feature -->
     <bool name="avrcp_controller_cover_art_browsed_images">false</bool>
