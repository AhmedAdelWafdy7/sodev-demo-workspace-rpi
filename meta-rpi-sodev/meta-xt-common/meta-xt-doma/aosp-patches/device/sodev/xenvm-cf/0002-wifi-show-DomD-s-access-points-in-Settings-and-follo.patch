diff --git a/DomaWifiRelay/Android.bp b/DomaWifiRelay/Android.bp
new file mode 100644
index 0000000..78a7481
--- /dev/null
+++ b/DomaWifiRelay/Android.bp
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// DomaWifiRelay -- closes the last gap in the shadow-AP Wi-Fi path: it is the only
+// component that can learn the passphrase the user typed on the AAOS Wi-Fi screen.
+//
+// WHY AN APP AT ALL. The shadow AP on wlan2 validates the typed password locally, and
+// it cannot recover that password from the 4-way handshake -- only a MIC crosses the
+// air. The framework is the only place the plaintext exists after the user types it,
+// and WifiManager.getPrivilegedConfiguredNetworks() is the only sanctioned way to read
+// it (WifiServiceImpl:3978 -> getConfiguredNetworksWithPasswords()). That API is
+// @SystemApi and permission-gated, so the reader has to be a platform app.
+//
+// WHY platform_apis AND NOT sdk_version: "system_current".
+//
+// Not the API surface: every member this app uses is @SystemApi (the
+// NetworkSelectionStatus class of WifiConfiguration and SystemProperties.get()
+// and getBoolean()), and both sources compile against
+// android_system_stubs_current.jar with 0 errors (measured on the PC). The
+// reason is the one recorded below next to system_ext_specific: soong refuses
+// platform_apis on a vendor/product module, this app is device-specific and
+// built in-tree with the platform, and pinning an API surface buys nothing
+// here.
+//
+// WHY certificate: "platform" + privileged, AND WHY THAT IS NOT SUFFICIENT ON ITS OWN.
+// NETWORK_SETTINGS is signature-level, so the platform key grants it, but
+// READ_WIFI_CREDENTIAL is signature|privileged, and an unlisted privileged
+// package keeps this image from booting. Measured:
+//
+//     NETWORK_SETTINGS       signature             frameworks/base/core/res/
+//     READ_WIFI_CREDENTIAL   signature|privileged      AndroidManifest.xml:2489, :2402
+//
+// The privileged flag turns the allowlist check into an AND gate placed in FRONT of the
+// signature grant (AppIdPermissionPolicy.kt:1143-1159), so the platform key does not
+// get past it; with ro.control_privapp_permissions=enforce an unlisted package throws
+// out of onSystemReady() (:1613, :1922). The proof that signing is irrelevant here is
+// in the same image: com.android.systemui is certificate: "platform" and still carries
+// an allowlist entry for READ_WIFI_CREDENTIAL, in
+// system_ext/etc/permissions/com.android.systemui.xml.
+//
+// Hence privapp_allowlist below. See that file for the full derivation.
+//
+// WHY NO NEARBY_WIFI_DEVICES / ACCESS_FINE_LOCATION RUNTIME GRANT. Both permission
+// paths inside getPrivilegedConfiguredNetworks short-circuit for a NETWORK_SETTINGS
+// holder -- measured: WifiPermissionsUtil.enforceCanAccessScanResults() returns
+// immediately when checkNetworkSettingsPermission(uid) is true, and so does
+// enforceNearbyDevicesPermission(). A headless app cannot show a grant dialog, so this
+// is what makes the app possible without default-grant plumbing.
+android_app {
+    name: "DomaWifiRelay",
+    srcs: ["src/**/*.java"],
+    platform_apis: true,
+    certificate: "platform",
+    privileged: true,
+    // Required, not optional: READ_WIFI_CREDENTIAL is signature|privileged. Installed
+    // to /system_ext/etc/permissions/DomaWifiRelay.xml -- soong names the installed
+    // file after the MODULE, and PathForModuleInstall follows system_ext_specific
+    // (build/soong/java/app.go:1230-1234). Needs privileged: true above
+    // (app.go:396-400).
+    privapp_allowlist: "privapp_allowlist_com.android.xt.domawifirelay.xml",
+    // Installs to /system_ext/priv-app, NOT /vendor/priv-app.
+    //
+    // MEASURED: soong refuses `platform_apis: true` on a vendor- or product-partition
+    // module -- "sdk_version must have a value when the module is located at vendor or
+    // product".
+    //
+    // system_ext is also the correct Treble placement independently of that: this app
+    // holds signature permissions, runs as android.uid.system and only talks to the
+    // framework, so it is coredomain -- and a coredomain app does not belong on the
+    // vendor partition. The vendor half of the relay is the shell daemon
+    // (/vendor/bin/doma-wifi-relay); the two communicate through a file in
+    // /data/vendor/wifi/shadow/req, not across a partition-crossing interface.
+    system_ext_specific: true,
+    optimize: {
+        enabled: false,
+    },
+}
diff --git a/DomaWifiRelay/AndroidManifest.xml b/DomaWifiRelay/AndroidManifest.xml
new file mode 100644
index 0000000..f9040eb
--- /dev/null
+++ b/DomaWifiRelay/AndroidManifest.xml
@@ -0,0 +1,51 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: Apache-2.0 -->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="com.android.xt.domawifirelay"
+    android:sharedUserId="android.uid.system">
+
+    <!-- NETWORK_SETTINGS: required by WifiManager.connect(int, ActionListener)
+         (WifiServiceImpl:7569 isPrivileged) and it is also what short-circuits every
+         location/nearby check inside getPrivilegedConfiguredNetworks. -->
+    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />
+    <!-- READ_WIFI_CREDENTIAL: enforceReadCredentialPermission() in
+         getPrivilegedConfiguredNetworks (WifiServiceImpl:3980). -->
+    <uses-permission android:name="android.permission.READ_WIFI_CREDENTIAL" />
+    <!-- ACCESS_WIFI_STATE: the permission the CONFIGURED_NETWORKS_CHANGED broadcast is
+         sent with (WifiConfigManager's
+         sendConfiguredNetworkChangedBroadcast()). -->
+    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
+    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
+
+    <!-- android:persistent keeps the process alive so the RUNTIME-registered
+         CONFIGURED_NETWORKS_CHANGED receiver stays live; a runtime receiver dies with
+         its process, and the wrong-password status change is the one event that must
+         not be missed. It is an <application> attribute, not a <service> one, and only
+         an android.uid.system app may ask for it. START_STICKY on the service is the
+         belt to this braces: if the process is killed anyway, init/AMS restarts it and
+         onCreate re-registers and re-sweeps, so a missed event is recovered at the next
+         config change rather than lost forever. -->
+    <application
+        android:label="DomA Wi-Fi Relay"
+        android:allowBackup="false"
+        android:persistent="true"
+        android:directBootAware="true">
+
+        <!-- BOOT_COMPLETED is one of the few implicit broadcasts a manifest receiver
+             may still register for; CONFIGURED_NETWORKS_CHANGED is not, which is why
+             that one is registered at RUNTIME by the service below. -->
+        <receiver
+            android:name=".BootReceiver"
+            android:exported="true"
+            android:directBootAware="true">
+            <intent-filter>
+                <action android:name="android.intent.action.BOOT_COMPLETED" />
+            </intent-filter>
+        </receiver>
+
+        <service
+            android:name=".RelayService"
+            android:exported="false"
+            android:directBootAware="true" />
+    </application>
+</manifest>
diff --git a/DomaWifiRelay/privapp_allowlist_com.android.xt.domawifirelay.xml b/DomaWifiRelay/privapp_allowlist_com.android.xt.domawifirelay.xml
new file mode 100644
index 0000000..e1c00f9
--- /dev/null
+++ b/DomaWifiRelay/privapp_allowlist_com.android.xt.domawifirelay.xml
@@ -0,0 +1,67 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: Apache-2.0
+
+     Privileged permission allowlist for DomaWifiRelay.
+
+     WHY THIS FILE IS REQUIRED.
+     READ_WIFI_CREDENTIAL is signature|privileged, not signature:
+
+         frameworks/base/core/res/AndroidManifest.xml
+           2402  <permission android:name="android.permission.READ_WIFI_CREDENTIAL"
+           2403      android:protectionLevel="signature|privileged" />
+
+     Once a permission carries the privileged flag, the allowlist check becomes an AND
+     gate placed IN FRONT of the signature grant, so holding the platform key is not
+     enough:
+
+         AppIdPermissionPolicy.kt
+           1143  val mayGrantByPrivileged =
+           1144      !permission.isPrivileged ||
+           1145          requestingPackageStates.anyIndexed { _, it ->
+           1146              checkPrivilegedPermissionAllowlistIfNeeded(it, permission)
+           1147          }
+           ...
+           1157  if (
+           1158      mayGrantByPrivileged &&
+           1159          (shouldGrantBySignature || shouldGrantByProtectionFlags)
+
+     and with ro.control_privapp_permissions=enforce (vendor/build.prop) a package that
+     is system AND privileged and is not listed here makes that helper return false
+     (:1613), which lands the package in privilegedPermissionAllowlistViolations and
+     makes onSystemReady() throw:
+
+           1922  if (!privilegedPermissionAllowlistViolations.isEmpty()) {
+           1923      throw IllegalStateException(
+
+     That is a system_server crash at every boot. AOSP documents the consequence
+     plainly: "In Android 9 and higher, privileged permissions must be allowlisted or
+     the device can't boot."
+     https://source.android.com/docs/core/permissions/perms-allowlist
+
+     The counter-example that settles it is in this same image: com.android.systemui is
+     built with certificate: "platform" (frameworks/base/packages/SystemUI/Android.bp)
+     and STILL carries an allowlist entry for this exact permission, in
+     system_ext/etc/permissions/com.android.systemui.xml. Platform signing does not
+     exempt a privileged app from the privileged allowlist.
+
+     NETWORK_SETTINGS IS DELIBERATELY ABSENT. It is signature only
+     (AndroidManifest.xml:2489-2490), so it is granted by the platform key and needs no
+     entry. Listing a non-privileged permission here is not harmless: it is what
+     CtsPrivappPermissionsTest reports as an error.
+
+     HOW THIS FILE IS INSTALLED. Android.bp sets privapp_allowlist, and soong installs
+     it with android.PathForModuleInstall(ctx, "etc", "permissions") using
+     installApkName + ".xml" (build/soong/java/app.go:1230-1234). Because the module is
+     system_ext_specific, that resolves to
+     /system_ext/etc/permissions/DomaWifiRelay.xml. Note that the file name is the
+     MODULE name, not the package name. SystemConfig reads every xml in the directory,
+     so only the package attribute below has to match.
+
+     NOTE for whoever edits this file: an XML comment may not contain two
+     consecutive hyphens, and a comment that does fails the build.
+-->
+<permissions>
+    <privapp-permissions package="com.android.xt.domawifirelay">
+        <permission name="android.permission.READ_WIFI_CREDENTIAL"/>
+    </privapp-permissions>
+</permissions>
diff --git a/DomaWifiRelay/src/com/android/xt/domawifirelay/BootReceiver.java b/DomaWifiRelay/src/com/android/xt/domawifirelay/BootReceiver.java
new file mode 100644
index 0000000..998cbef
--- /dev/null
+++ b/DomaWifiRelay/src/com/android/xt/domawifirelay/BootReceiver.java
@@ -0,0 +1,40 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.xt.domawifirelay;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.util.Log;
+
+/**
+ * Starts {@link RelayService} at boot.
+ *
+ * <p>BOOT_COMPLETED is one of the few implicit broadcasts a manifest-declared receiver
+ * may still register for. CONFIGURED_NETWORKS_CHANGED, the broadcast this app actually
+ * cares about, is not, so it is registered at runtime by the service. That is also the
+ * only way to receive it reliably: WifiConfigManager sends it with
+ * FLAG_RECEIVER_REGISTERED_ONLY_BEFORE_BOOT (WifiConfigManager:1145).
+ */
+public final class BootReceiver extends BroadcastReceiver {
+    private static final String TAG = "DomaWifiRelay";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (!Intent.ACTION_BOOT_COMPLETED.equals(intent.getAction())) {
+            return;
+        }
+        // Started UNCONDITIONALLY, and the service checks the property and the Settings
+        // Wi-Fi toggle on every sweep instead of at startup.
+        //
+        // WHY: gating the start on the property would make a later setprop
+        // ineffective. The setprop starts or stops the DAEMON (init has
+        // property triggers for it), but nothing would start this SERVICE --
+        // BOOT_COMPLETED has already fired, and android:persistent starts the
+        // process, not the service. Starting always and deciding per sweep
+        // costs one idle receiver and lets both switches take effect at the
+        // next sweep.
+        context.startService(new Intent(context, RelayService.class));
+    }
+}
diff --git a/DomaWifiRelay/src/com/android/xt/domawifirelay/RelayService.java b/DomaWifiRelay/src/com/android/xt/domawifirelay/RelayService.java
new file mode 100644
index 0000000..243ac4e
--- /dev/null
+++ b/DomaWifiRelay/src/com/android/xt/domawifirelay/RelayService.java
@@ -0,0 +1,445 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.xt.domawifirelay;
+
+import android.app.Service;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.net.wifi.WifiConfiguration;
+import android.net.wifi.WifiManager;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.SystemProperties;
+import android.util.Log;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.OutputStreamWriter;
+import java.nio.charset.StandardCharsets;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Makes an arbitrary real AP connectable from the AAOS Wi-Fi screen.
+ *
+ * <h2>The problem</h2>
+ * DomA has no radio. Its {@code wlan0} is a {@code mac80211_hwsim} station that
+ * associates with a local hostapd (the "shadow AP") on {@code wlan2}, and the real
+ * association is performed by DomD. The password the user types is therefore validated
+ * by the LOCAL hostapd, whose passphrase comes from
+ * {@code /data/vendor/wifi/shadow/aps.conf}. A shadow AP cannot learn a PSK from the
+ * 4-way handshake -- only a MIC crosses the air -- so an SSID whose PSK is not already
+ * in that file cannot be connected to, and the framework does not merely retry:
+ *
+ * <pre>
+ *   config_wifiDisableReasonByWrongPasswordThreshold  = 1
+ *   config_wifiDisableReasonByWrongPasswordDurationMs = -1   (permanent)
+ * </pre>
+ *
+ * so ONE failed handshake sets
+ * {@link WifiConfiguration.NetworkSelectionStatus#DISABLED_BY_WRONG_PASSWORD} and the
+ * network stops being attempted.
+ *
+ * <h2>What this service does</h2>
+ * It is purely CORRECTIVE. It reacts only to a config that has ALREADY been permanently
+ * disabled for a wrong password, which means it does nothing at all while the normal
+ * path (an SSID whose PSK aps.conf already holds) is working -- a deliberate
+ * property, so a bug in here cannot break that path. On such a config it:
+ *
+ * <ol>
+ *   <li>reads the plaintext passphrase with
+ *       {@link WifiManager#getPrivilegedConfiguredNetworks()} (the only sanctioned
+ *       route; it returns {@code preSharedKey} unmasked),</li>
+ *   <li>hands it to {@code /vendor/bin/doma-wifi-relay}, which puts it into
+ *       {@code aps.conf}, regenerates {@code hostapd.conf}, restarts hostapd and
+ *       forwards a {@code connect} message to DomD over virtio-serial,</li>
+ *   <li>calls {@link WifiManager#connect(int, WifiManager.ActionListener)}, which
+ *       clears the permanent disable unconditionally:
+ *       {@code ConnectHelper.connectToNetwork()} then
+ *       {@code WifiConfigManager.updateBeforeConnect()} then {@code enableNetwork()}
+ *       then {@code WifiBlocklistMonitor.setNetworkSelectionEnabled()}, which resets the
+ *       status, the reason AND {@code clearDisableReasonCounter()}. The same call's
+ *       {@code onEnableNetwork()} also drops the SSID's BSSID blocklist entries
+ *       (WifiBlocklistMonitor:755-775), so the retry re-attempts the same BSS.</li>
+ * </ol>
+ *
+ * <p>The retry therefore succeeds: hostapd now holds the passphrase the user typed.
+ *
+ * <h2>Loop safety</h2>
+ * Every (netId, passphrase) pair is attempted at most once. If the passphrase really is
+ * wrong for the real AP, DomD's association fails while the local one succeeds, and the
+ * user sees "connected, no internet" rather than an endless reconnect storm. Typing a
+ * different password produces a different pair and gets one fresh attempt.
+ *
+ * <p>LAB USE ONLY. The passphrase is written to a file and crosses a virtio-serial
+ * channel in the clear. Same warning as {@code domd_wifi_agent.py}.
+ */
+public final class RelayService extends Service {
+    private static final String TAG = "DomaWifiRelay";
+
+    /**
+     * Read per sweep. Unset (the default) or "true" lets the repair run while the Settings
+     * Wi-Fi toggle is on, and any other value turns it off: the same two values
+     * init.xenvm-hwsim.rc starts the daemon on, compared as strings as init compares them.
+     */
+    static final String PROP_ENABLED = "persist.vendor.doma.wifi_relay";
+
+    /**
+     * Drop-box the daemon polls. init.xenvm-hwsim.rc creates it 0770 wifi:<b>system</b>
+     * (and doma-wifi-relay chowns it to match) precisely so this app -- uid/gid system,
+     * because NETWORK_SETTINGS and READ_WIFI_CREDENTIAL are signature permissions and
+     * android.uid.system is the only way to hold them -- can create the file in it.
+     *
+     * <p><b>Owning the last directory is not enough.</b> Creating a file here also needs
+     * the search (x) bit on <em>every</em> parent, and both {@code /data/vendor/wifi}
+     * and {@code /data/vendor/wifi/shadow} are 0770 wifi:wifi, which uid system is not a
+     * member of (platform.xml grants no {@code gid="wifi"} through any permission).
+     * Measured on a PC with the same owners and modes (2026-09-08):
+     * both parents 0770 -> EACCES; only {@code /data/vendor/wifi} given o+x -> still
+     * EACCES; both given o+x (0771) -> the write succeeds, while {@code hostapd.conf}
+     * stays unreadable (0660 wifi:wifi) and the directory stays unlistable. So the rc
+     * adds o+x -- traversal only -- on {@code sys.boot_completed}, which is
+     * after the unconditional {@code on boot} block where cuttlefish's
+     * init.vendor.rc:85 sets {@code /data/vendor/wifi} back to 0770 (init's
+     * mkdir re-applies the mode to an existing directory:
+     * system/core/init/builtins.cpp:394-436).
+     */
+    private static final File REQ_DIR = new File("/data/vendor/wifi/shadow/req");
+    private static final File REQ = new File(REQ_DIR, "relay.req");
+    private static final File REQ_TMP = new File(REQ_DIR, "relay.req.tmp");
+
+    /**
+     * One polling window. The daemon's own loop reads the channel with {@code read -t 2},
+     * so 4 s is two of its ticks. Waiting too little is the failure that matters:
+     * connect() would race hostapd, fail the handshake again and re-arm
+     * DISABLED_BY_WRONG_PASSWORD.
+     */
+    private static final long DAEMON_GRACE_MS = 4000;
+
+    /**
+     * How many {@link #DAEMON_GRACE_MS} windows to wait for the daemon to take the
+     * request. {@link #connectWhenConsumed} looks at the drop-box each window
+     * and only connects once the request is gone.
+     *
+     * <p>The bound comes from the daemon's own worst case rather than from its poll
+     * interval. In one iteration of doma-wifi-relay.sh, {@code restart_hostapd} can
+     * spend its whole poll loop (100 iterations of {@code sleep 0.1}) plus
+     * {@code confirm_hostapd_running} (6 x 0.5 s) -- about 13 s; its own
+     * comment says the wait STALLS THE MAIN LOOP FOR UP TO 10 s -- and BOTH
+     * {@code handle_aps} and {@code flush_pending_restart} can fire it in the
+     * same iteration, with
+     * {@code read -t 2} on top: roughly 28 s. (The one figure actually measured on a PC
+     * is 10.371 s for a single restart_hostapd, which does not include the confirm
+     * window.) 10 x 4 s = 40 s therefore covers a healthy-but-busy daemon, and the cost
+     * is zero on the normal path, where the request is gone at the first check.
+     */
+    private static final int REQ_POLLS = 10;
+
+    /**
+     * The daemon's init service state, for diagnostics only -- never as a liveness test.
+     * {@code init.svc.<name>} is published by NotifyStateChange() alone
+     * (system/core/init/service.cpp:192), so it is EMPTY for a service that has never
+     * started, and "running" is set in the PARENT right after fork (:817) whether or not
+     * the child survives. init.xenvm-hwsim.rc declares the relay as
+     * {@code doma_wifi_relay}, without the {@code vendor.} prefix the hostapd
+     * service carries. This app is system_app, i.e. coredomain, so it may read
+     * the {@code init.svc.} type without any extra policy.
+     */
+    private static final String PROP_RELAY_SVC_STATE = "init.svc.doma_wifi_relay";
+
+    private WifiManager mWifi;
+    private HandlerThread mThread;
+    private Handler mHandler;
+    /**
+     * (netId, psk) pairs whose single repair attempt has been SPENT. The key is
+     * {@code netId + " " + psk} and nothing ever clears it, so recovery needs a
+     * different password, forget+re-add, or a restart of this process; the permanent
+     * disable itself survives reboots (WifiConfigStore's XmlUtil). Only the mHandler
+     * thread touches it, so no synchronisation is needed.
+     *
+     * <p>An entry is added only AFTER the request is in the drop-box, and is
+     * removed again if the daemon never takes it: adding it before
+     * {@link #repair} would burn the attempt even when nothing was written, and
+     * since the key never expires that network would stay disabled forever.
+     */
+    private final Set<String> mAttempted = new HashSet<>();
+
+    static boolean isEnabled() {
+        final String v = SystemProperties.get(PROP_ENABLED, "");
+        return v.isEmpty() || "true".equals(v);
+    }
+
+    private final BroadcastReceiver mReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            mHandler.post(RelayService.this::sweep);
+        }
+    };
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        // NOT gated on isEnabled() here. The property is read per sweep instead, so
+        // `setprop persist.vendor.doma.wifi_relay false` takes effect without a reboot --
+        // see BootReceiver for why starting conditionally did not work.
+        mWifi = getSystemService(WifiManager.class);
+        if (mWifi == null) {
+            Log.e(TAG, "no WifiManager; stopping");
+            stopSelf();
+            return;
+        }
+        mThread = new HandlerThread(TAG);
+        mThread.start();
+        mHandler = new Handler(mThread.getLooper());
+
+        // Runtime registration, not the manifest: CONFIGURED_NETWORKS_CHANGED is an
+        // implicit broadcast a manifest receiver may not register for, and it is sent
+        // with FLAG_RECEIVER_REGISTERED_ONLY_BEFORE_BOOT (WifiConfigManager:1145).
+        // WIFI_STATE_CHANGED as well, so a config left disabled while the Settings Wi-Fi
+        // toggle was off is repaired as soon as the toggle comes back on.
+        final IntentFilter filter =
+                new IntentFilter(WifiManager.CONFIGURED_NETWORKS_CHANGED_ACTION);
+        filter.addAction(WifiManager.WIFI_STATE_CHANGED_ACTION);
+        registerReceiver(mReceiver, filter);
+        Log.i(TAG, "started (" + PROP_ENABLED + "=\"" + SystemProperties.get(PROP_ENABLED, "")
+                + "\", enabled=" + isEnabled() + ")");
+        mHandler.post(this::sweep);
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        return START_STICKY;
+    }
+
+    @Override
+    public void onDestroy() {
+        if (mThread != null) {
+            try {
+                unregisterReceiver(mReceiver);
+            } catch (IllegalArgumentException ignored) {
+                // Never registered, because onCreate bailed out early.
+            }
+            mThread.quitSafely();
+        }
+        super.onDestroy();
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+
+    /** Find configs disabled for a wrong password and repair each one once. */
+    private void sweep() {
+        if (!isEnabled()) {
+            // Inert, not stopped: the property may be flipped at any time and this is
+            // the only place that has to notice.
+            return;
+        }
+        if (!mWifi.isWifiEnabled()) {
+            // The Settings Wi-Fi toggle is off: a repair would ask DomD to associate for
+            // a user who has just switched Wi-Fi off. The daemon holds requests then as
+            // well; WIFI_STATE_CHANGED brings the sweep back when the toggle is on.
+            return;
+        }
+        final List<WifiConfiguration> configs;
+        try {
+            configs = mWifi.getPrivilegedConfiguredNetworks();
+        } catch (SecurityException e) {
+            // Signature permissions are missing, which means the APK is not
+            // platform-signed. Nothing this service does can work; say so and stop.
+            // Do NOT stopSelf() here: android:persistent would restart the process and
+            // the same denial would be logged in a loop. Staying up and inert keeps the
+            // one diagnostic line visible in logcat, which is the whole value of this
+            // branch.
+            Log.e(TAG, "getPrivilegedConfiguredNetworks denied -- is the APK signed with"
+                    + " the platform key and privileged?", e);
+            return;
+        }
+        if (configs == null) {
+            // WifiServiceImpl returns null, not an exception, when a permission check
+            // inside its pre-T / T branches fails.
+            Log.w(TAG, "getPrivilegedConfiguredNetworks returned null");
+            return;
+        }
+        for (WifiConfiguration c : configs) {
+            if (c == null || c.getNetworkSelectionStatus() == null) {
+                continue;
+            }
+            if (c.getNetworkSelectionStatus().getNetworkSelectionDisableReason()
+                    != WifiConfiguration.NetworkSelectionStatus.DISABLED_BY_WRONG_PASSWORD) {
+                continue;
+            }
+            final String ssid = unquote(c.SSID);
+            final String psk = unquote(c.preSharedKey);
+            if (ssid.isEmpty() || psk.isEmpty()) {
+                // An open network (no PSK) cannot fail a handshake. A 64-digit
+                // hex PSK is stored unquoted, unquote() leaves it as it is, and
+                // the relay takes it as a raw PSK.
+                Log.w(TAG, "skipping " + ssid + ": no usable passphrase");
+                continue;
+            }
+            final String key = c.networkId + " " + psk;
+            if (mAttempted.contains(key)) {
+                Log.i(TAG, "already attempted netId=" + c.networkId + "; leaving disabled");
+                continue;
+            }
+            if (!repair(c.networkId, ssid, psk, key)) {
+                // Nothing was written, so nothing is spent: try the next candidate.
+                // continue rather than return -- the drop-box is untouched so there is
+                // no race to lose, and no connect() was issued so this cannot loop.
+                continue;
+            }
+            // Spend the attempt only now that the request is in the drop-box.
+            mAttempted.add(key);
+            // ONE PER SWEEP, AND RETURN.
+            //
+            // The request drop-box holds a single file and the daemon polls it every
+            // 2 s, so two repairs started in the same pass would race: the second
+            // renameTo(REQ) clobbers the first before the daemon reads it.
+            // repair() refuses to overwrite a request that is still sitting
+            // there, so a second write needs the daemon to have consumed the
+            // first one inside the grace window -- and in that case the first
+            // request's polling sees the second one and returns its attempt to
+            // the pool. The loss is then not permanent, just a skip that the
+            // next sweep retries. Returning here
+            // costs nothing: connect() changes the network selection status, which
+            // makes WifiConfigManager send CONFIGURED_NETWORKS_CHANGED again
+            // (sendConfiguredNetworkChangedBroadcast()), and the next sweep
+            // picks up the next one.
+            return;
+        }
+    }
+
+    /**
+     * Is a request still waiting to be picked up?
+     *
+     * <p>This uses the SAME predicate as the daemon. doma-wifi-relay.sh tests
+     * {@code [ -s "$REQ" ]} -- non-empty -- and only then moves the file aside
+     * ({@code mv "$REQ" "$REQ.busy"}). Testing {@code exists()} instead would treat a
+     * zero-byte file as "still pending" forever, because the daemon will never take it:
+     * the drop-box lives on /data, so that would be a deadlock which survives reboots
+     * and needs a manual rm. (writeRequest() writes to a temporary name and renames, so
+     * a zero-byte REQ should not happen -- which is exactly why the predicates must not
+     * disagree about it.)
+     */
+    private boolean requestPending() {
+        return REQ.length() > 0;
+    }
+
+    /** Diagnostics only; see {@link #PROP_RELAY_SVC_STATE}. */
+    private static String relaySvcState() {
+        final String s = SystemProperties.get(PROP_RELAY_SVC_STATE, "");
+        return s.isEmpty() ? "<unset>" : s;
+    }
+
+    /**
+     * @return true if a request was written -- i.e. if the caller should spend the
+     *         attempt. False means nothing was written and nothing is spent.
+     */
+    private boolean repair(final int netId, String ssid, String psk, final String key) {
+        if (requestPending()) {
+            Log.w(TAG, "a request is still unconsumed in " + REQ + "; the daemon is not"
+                    + " reading it (" + PROP_RELAY_SVC_STATE + "=" + relaySvcState()
+                    + "). Not attempting netId=" + netId + " -- attempt NOT spent."
+                    + " Check: setprop " + PROP_ENABLED + " true;"
+                    + " start doma_wifi_relay; logcat -s doma-wifi-relay");
+            return false;
+        }
+        Log.i(TAG, "repairing netId=" + netId + " ssid=" + ssid);
+        if (!writeRequest(ssid, psk)) {
+            return false;
+        }
+        connectWhenConsumed(netId, key, REQ_POLLS);
+        return true;
+    }
+
+    /**
+     * Wait for the daemon to take the request, then re-trigger the connect. If it never
+     * takes it, return the attempt to the pool instead of burning it.
+     */
+    private void connectWhenConsumed(final int netId, final String key, final int polls) {
+        mHandler.postDelayed(new Runnable() {
+            @Override
+            public void run() {
+                if (requestPending()) {
+                    if (polls > 1) {
+                        connectWhenConsumed(netId, key, polls - 1);
+                        return;
+                    }
+                    mAttempted.remove(key);
+                    Log.w(TAG, "daemon did not consume the request within "
+                            + (REQ_POLLS * DAEMON_GRACE_MS) + " ms ("
+                            + PROP_RELAY_SVC_STATE + "=" + relaySvcState()
+                            + "); not connecting netId=" + netId
+                            + ", attempt NOT spent. Check: logcat -s doma-wifi-relay");
+                    return;
+                }
+                Log.i(TAG, "re-triggering connect netId=" + netId);
+                mWifi.connect(netId, new WifiManager.ActionListener() {
+                    @Override
+                    public void onSuccess() {
+                        Log.i(TAG, "connect(" + netId + ") accepted");
+                    }
+
+                    @Override
+                    public void onFailure(int reason) {
+                        Log.w(TAG, "connect(" + netId + ") rejected, reason=" + reason);
+                    }
+                });
+            }
+        }, DAEMON_GRACE_MS);
+    }
+
+    /**
+     * Write one tab-separated {@code psk} request line for the daemon.
+     *
+     * <p>Written to a temporary name and renamed, so the daemon can never read a partial
+     * line: it polls for the final name only, and its own first action is to move the
+     * file aside.
+     */
+    private boolean writeRequest(String ssid, String psk) {
+        if (!REQ_DIR.isDirectory()) {
+            // isDirectory() is also false when the directory exists but a parent denies
+            // search, which is the failure this path actually hit (see the field's
+            // javadoc). Saying "missing" there sends the reader looking for the daemon
+            // instead of at the modes, so name both causes.
+            Log.e(TAG, REQ_DIR + " is not reachable -- either doma-wifi-relay has not "
+                    + "created it yet, or a parent lacks o+x (check: ls -ld "
+                    + "/data/vendor/wifi /data/vendor/wifi/shadow -- both need 0771)");
+            return false;
+        }
+        try (FileOutputStream fos = new FileOutputStream(REQ_TMP);
+                OutputStreamWriter w = new OutputStreamWriter(fos, StandardCharsets.UTF_8)) {
+            w.write("psk\t" + ssid + "\t" + psk + "\n");
+            w.flush();
+            fos.getFD().sync();
+        } catch (IOException e) {
+            Log.e(TAG, "cannot write " + REQ_TMP, e);
+            return false;
+        }
+        if (!REQ_TMP.renameTo(REQ)) {
+            Log.e(TAG, "cannot rename " + REQ_TMP + " to " + REQ);
+            REQ_TMP.delete();
+            return false;
+        }
+        return true;
+    }
+
+    /** WifiConfiguration keeps SSID and preSharedKey wrapped in literal double quotes. */
+    private static String unquote(String s) {
+        if (s == null) {
+            return "";
+        }
+        if (s.length() >= 2 && s.charAt(0) == '"' && s.charAt(s.length() - 1) == '"') {
+            return s.substring(1, s.length() - 1);
+        }
+        return s;
+    }
+}
diff --git a/aosp_xenvm_trout_rpi4_arm64.mk b/aosp_xenvm_trout_rpi4_arm64.mk
index 7b335c8..5d591dc 100644
--- a/aosp_xenvm_trout_rpi4_arm64.mk
+++ b/aosp_xenvm_trout_rpi4_arm64.mk
@@ -10,8 +10,9 @@
 #
 # The inherit has to come first for PRODUCT_* : the upstream makefile ends with its own
 # PRODUCT_NAME / PRODUCT_DEVICE / PRODUCT_MODEL assignments, so ours have to be written
-# after it to win. The block below is the exact opposite and has to come BEFORE, for a
-# reason worth spelling out because it is easy to get backwards:
+# after it to win. (The one PRODUCT_COPY_FILES line above the inherit is the opposite
+# case on purpose; its comment says why.) The block below is the exact opposite and has
+# to come BEFORE, for a reason worth spelling out because it is easy to get backwards:
 #
 #   $(call inherit-product) does not include anything at the point it appears. It only
 #   pushes an $(INHERIT_TAG)<path> marker onto every product variable
@@ -63,6 +64,14 @@
 # on the board, one level at a time.
 TARGET_VULKAN_SUPPORT := false
 
+# ABOVE the inherit, on purpose: for one destination the first PRODUCT_COPY_FILES entry
+# wins (build/make/core/Makefile:139-156), and inherit-product puts the parent's entries
+# where the inherit line is (product.mk:539-540), so a line below it would be dropped
+# silently. This replaces trout's virtwifi.rc, which enabled Wi-Fi at every boot; see
+# the file.
+PRODUCT_COPY_FILES += \
+    device/sodev/xenvm-cf/xenvm_trout_rpi4_arm64/virtwifi.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/virtwifi.rc
+
 $(call inherit-product, device/epam/aosp-xenvm-trout/aosp_xenvm_trout_arm64.mk)
 
 PRODUCT_NAME := aosp_xenvm_trout_rpi4_arm64
@@ -111,3 +120,98 @@ PRODUCT_COPY_FILES += \
 # animations off (the device model, not the GPU, pays for them). The overlay file
 # carries the measurements and the runtime equivalents for an existing /data.
 DEVICE_PACKAGE_OVERLAYS += device/sodev/xenvm-cf/overlay
+
+# Shadow-AP Wi-Fi: simulated radios in this guest beaconing the SSIDs DomD really
+# sees, so the Settings Wi-Fi screen lists real access points instead of virt_wifi's
+# single synthetic "VirtWifi".
+#
+# IT STARTS AUTOMATICALLY at sys.boot_completed, and the product ships no rc
+# that starts virt_wifi: the two must never both own wlan0. No hand-typed
+# command is needed to bring the Wi-Fi path up.
+#
+# The service is declared `disabled`; the only thing that starts it is
+# `on property:sys.boot_completed=1` in the rc. The script reads
+# persist.vendor.doma.shadow_ap (default true) at its TOP, and when it is not
+# true it execs setup_wifi --interface=eth1 instead, handing wlan0 back to
+# virt_wifi. So a failure of hostapd and the Wi-Fi HAL to coexist in one guest
+# is recovered from on hardware with
+#     setprop persist.vendor.doma.shadow_ap false && reboot
+# rather than with an SD rewrite. setup_wifi itself lives in the
+# com.google.cf.wifi apex, so the fallback needs no rc of its own.
+PRODUCT_COPY_FILES += \
+    device/sodev/xenvm-cf/xenvm_trout_rpi4_arm64/init.xenvm-hwsim.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/init.xenvm-hwsim.rc \
+    device/sodev/xenvm-cf/xenvm_trout_rpi4_arm64/doma-shadow-ap.sh:$(TARGET_COPY_OUT_VENDOR)/bin/doma-shadow-ap \
+    device/sodev/xenvm-cf/xenvm_trout_rpi4_arm64/doma-shadow-aps.conf:$(TARGET_COPY_OUT_VENDOR)/etc/doma-shadow-aps.conf \
+    device/sodev/xenvm-cf/xenvm_trout_rpi4_arm64/doma-wifi-relay.sh:$(TARGET_COPY_OUT_VENDOR)/bin/doma-wifi-relay
+
+# WHY doma-shadow-aps.conf IS SHIPPED AT ALL.
+# doma-shadow-ap dies with "$APS is empty" if /data/vendor/wifi/shadow/aps.conf
+# has no content, and /data is empty on a first boot, so on a freshly flashed
+# card the AAOS Wi-Fi screen would list nothing and there would be nothing to
+# select. The script merges this file into aps.conf on every boot, adding only
+# the SSIDs aps.conf lacks, so a row the relay or the user has written is never
+# overwritten.
+#
+# IT CARRIES ONE PLACEHOLDER ROW, EXAMPLE-SSID, AND NO REAL PASSPHRASE: this
+# file is in the source tree and in the vendor image. A real AP's passphrase is
+# typed on the Wi-Fi screen and reaches the shadow AP through DomaWifiRelay; the
+# file's own header says how, and why a shadow AP cannot learn it any other way.
+
+# wificond. WifiNative talks to it over binder to do the nl80211 setup of wlan0, so
+# without it enabling Wi-Fi fails at exactly one line -- "Failed to setup iface in
+# nl80211=wlan0" -- and the vendor HAL then tears the interface straight back down.
+#
+# It is missing here for a subtle reason worth writing down: the inherited product set
+# DOES include wificond_compat_symlink_module, which installs
+# /system/bin/wificond -> /system/system_ext/bin/wificond, but it does NOT include
+# wificond itself. The result is a DANGLING SYMLINK and no wificond.rc anywhere in
+# /system, so `start wificond` answers "Could not find 'wificond'". Verified on the
+# running guest and in the build: product_packages.txt lists only
+# wificond_compat_symlink_module, while all_modules.txt has wificond -- buildable,
+# just never selected.
+#
+# Measured on hardware before adding this (logcat, DomA):
+#   android.hardware.wifi-service: Adding interface handle for wlan0
+#   android.hardware.wifi-service: Configured chip in mode 3      <- vendor HAL is fine
+#   WifiNative: Failed to setup iface in nl80211=wlan0            <- wificond missing
+#   WifiVendorHal: onIfaceRemoved 0, name: wlan0
+#   WifiActiveModeWarden: ClientModeManager start failed!
+PRODUCT_PACKAGES += wificond
+
+# ---------------------------------------------------------------------------
+# WHY DomaWifiRelay. It is the ONLY component that can learn the passphrase the user
+# types on the AAOS Wi-Fi screen. The shadow AP on wlan2 validates that passphrase
+# locally and cannot recover it from the 4-way handshake -- only a MIC crosses the air --
+# so an SSID whose PSK is not already in /data/vendor/wifi/shadow/aps.conf cannot be
+# connected to. Worse, one failed handshake disables the network PERMANENTLY:
+# config_wifiDisableReasonByWrongPasswordThreshold is 1 and
+# ...DurationMs is -1 in ServiceWifiResources/res/values/config.xml.
+#
+# The app reads the plaintext PSK with WifiManager.getPrivilegedConfiguredNetworks(),
+# hands it to /vendor/bin/doma-wifi-relay (which updates hostapd and forwards it to
+# DomD), and then calls WifiManager.connect(netId, ...), which clears the permanent
+# disable unconditionally via WifiConfigManager.updateBeforeConnect() ->
+# enableNetwork() -> WifiBlocklistMonitor.setNetworkSelectionEnabled().
+#
+# PURELY CORRECTIVE, AND IT FOLLOWS THE SETTINGS WI-FI TOGGLE. It acts only on a config
+# ALREADY disabled for a wrong password, and only while Wi-Fi is on. Both halves also
+# read persist.vendor.doma.wifi_relay: unset (the default) or true runs them, and
+#     setprop persist.vendor.doma.wifi_relay false
+# turns both off.
+#
+# Installs to /system_ext/priv-app (system_ext_specific + privileged in its
+# Android.bp), not /vendor: soong rejects platform_apis on a vendor-partition module,
+# and a platform-signed android.uid.system app that only talks to the framework is
+# coredomain, which does not belong on vendor anyway. The vendor half is the shell
+# daemon /vendor/bin/doma-wifi-relay; they meet at a file in
+# /data/vendor/wifi/shadow/req, not across a partition interface.
+#
+# A privapp-permissions allowlist entry IS needed. NETWORK_SETTINGS is
+# signature-level, so the platform key grants it; but READ_WIFI_CREDENTIAL is
+# signature|privileged, and for a privileged permission the allowlist check is
+# an AND gate in front of the signature grant, so an unlisted package makes
+# system_server throw at every boot. The entry ships with the app through
+# Android.bp's privapp_allowlist; the derivation is in
+# DomaWifiRelay/privapp_allowlist_com.android.xt.domawifirelay.xml.
+PRODUCT_PACKAGES += \
+    DomaWifiRelay
