+
+/*
+ * Which stepping's tables to use. Default C0, i.e. upstream behaviour is unchanged;
+ * RPI5_PINCTRL_D0=1 at build time selects D0. This is a build switch and not a
+ * runtime probe because this platform does not parse the DTB: the VideoCore
+ * firmware applies bcm2712d0.dtbo to it on D0 boards, but TF-A only passes its
+ * address on to the images it starts, so a probe would mean DT parsing at EL3.
+ * The C0 tables on D0 silicon address pad registers past the end of the block,
+ * an unrecoverable EL3 abort; the D0 tables on C0 silicon program other pins.
+ */
+#ifndef RPI5_PINCTRL_D0
+#define RPI5_PINCTRL_D0 0
+#endif
+
+#if RPI5_PINCTRL_D0
+#define BCM2712_PIN_REGS	bcm2712_d0_gpio_pin_regs
+#define BCM2712_GPIO_PINS	bcm2712_d0_gpio_pins
+#define BCM2712_FUNCS_GROUPS	bcm2712_d0_gpio_funcs_groups
+#define BCM2712_PIN_FUNCS	bcm2712_d0_gpio_pin_funcs
+#else
+#define BCM2712_PIN_REGS	bcm2712_c0_gpio_pin_regs
+#define BCM2712_GPIO_PINS	bcm2712_c0_gpio_pins
+#define BCM2712_FUNCS_GROUPS	bcm2712_c0_gpio_funcs_groups
+#define BCM2712_PIN_FUNCS	bcm2712_c0_gpio_pin_funcs
+#endif
+
 static inline uint32_t bcm2712_pfc_reg_rd(unsigned int reg)
 {
 	return mmio_read_32(RPI_PINCTRL_BASE + reg);
@@ -455,7 +664,7 @@
 
 static enum bcm2712_pfc_funcs bcm2712_pfc_fsel_get(unsigned int pin)
 {
-	uint16_t bit = bcm2712_c0_gpio_pin_regs[pin].mux_bit;
+	uint16_t bit = BCM2712_PIN_REGS[pin].mux_bit;
 	enum bcm2712_pfc_funcs func;
 	uint32_t val;
 	uint32_t fsel;
@@ -468,7 +677,7 @@
 
 	val = bcm2712_pfc_reg_rd(BIT_TO_REG(bit));
 	fsel = (val >> BIT_TO_SHIFT(bit)) & BCM2712_FSEL_MASK;
-	func = bcm2712_c0_gpio_pin_funcs[pin].funcs[fsel];
+	func = BCM2712_PIN_FUNCS[pin].funcs[fsel];
 	if (func >= func_count) {
 		func = (enum bcm2712_pfc_funcs)fsel;
 	}
@@ -482,7 +691,7 @@
 static void bcm2712_pinctrl_fsel_set(unsigned int pin,
 				     enum bcm2712_pfc_funcs func)
 {
-	uint16_t bit = bcm2712_c0_gpio_pin_regs[pin].mux_bit;
+	uint16_t bit = BCM2712_PIN_REGS[pin].mux_bit;
 	const uint8_t *pin_funcs;
 	uint32_t val;
 	uint32_t fsel;
@@ -498,7 +707,7 @@
 
 	if (func >= BCM2712_FSEL_COUNT) {
 		/* Convert to an fsel number */
-		pin_funcs = bcm2712_c0_gpio_pin_funcs[pin].funcs;
+		pin_funcs = BCM2712_PIN_FUNCS[pin].funcs;
 		for (i = 1; i < BCM2712_FSEL_COUNT; i++) {
 			if (pin_funcs[i - 1] == func) {
 				fsel = i;
@@ -530,7 +739,7 @@
 
 static unsigned int bcm2712_pfc_pull_config_get(unsigned int pin)
 {
-	uint32_t bit = bcm2712_c0_gpio_pin_regs[pin].pad_bit;
+	uint32_t bit = BCM2712_PIN_REGS[pin].pad_bit;
 	uint32_t val;
 
 	if (bit == REG_BIT_INVALID) {
@@ -543,7 +752,7 @@
 
 static void bcm2712_pfc_pull_config_set(unsigned int pin, unsigned int arg)
 {
-	uint32_t bit = bcm2712_c0_gpio_pin_regs[pin].pad_bit;
+	uint32_t bit = BCM2712_PIN_REGS[pin].pad_bit;
 	uint32_t val;
 
 	if (bit == REG_BIT_INVALID) {
@@ -562,15 +771,15 @@
 uint32_t pinctrl_get_groups_count(void)
 {
 	VERBOSE("%s: %lu\n", __func__,
-		ARRAY_SIZE(bcm2712_c0_gpio_pins));
-	return ARRAY_SIZE(bcm2712_c0_gpio_pins);
+		ARRAY_SIZE(BCM2712_GPIO_PINS));
+	return ARRAY_SIZE(BCM2712_GPIO_PINS);
 }
 
 const char *pinctrl_get_group_name(uint32_t group_id)
 {
 	VERBOSE("%s: %u\n", __func__, group_id);
 
-	return bcm2712_c0_gpio_pins[group_id].name;
+	return BCM2712_GPIO_PINS[group_id].name;
 }
 
 int pinctrl_get_group_pins(uint32_t group_id, const unsigned int **pins,
@@ -578,27 +787,27 @@
 {
 	VERBOSE("%s: %u\n", __func__, group_id);
 	*num_pins = 1;
-	*pins = &bcm2712_c0_gpio_pins[group_id].pin;
+	*pins = &BCM2712_GPIO_PINS[group_id].pin;
 
 	return 0;
 }
 
 uint32_t pinctrl_get_pins_count(void)
 {
-	VERBOSE("%s: %lu\n", __func__, ARRAY_SIZE(bcm2712_c0_gpio_pins));
-	return ARRAY_SIZE(bcm2712_c0_gpio_pins);
+	VERBOSE("%s: %lu\n", __func__, ARRAY_SIZE(BCM2712_GPIO_PINS));
+	return ARRAY_SIZE(BCM2712_GPIO_PINS);
 }
 
 const char *pinctrl_get_pin_name(uint32_t pin_id)
 {
-	assert(pin_id < ARRAY_SIZE(bcm2712_c0_gpio_pins));
-	return bcm2712_c0_gpio_pins[pin_id].name;
+	assert(pin_id < ARRAY_SIZE(BCM2712_GPIO_PINS));
+	return BCM2712_GPIO_PINS[pin_id].name;
 }
 
 int pinctrl_get_pins(const struct pinctrl_pin **pins, uint32_t *num_pins)
 {
-	*num_pins = ARRAY_SIZE(bcm2712_c0_gpio_pins);
-	*pins = bcm2712_c0_gpio_pins;
+	*num_pins = ARRAY_SIZE(BCM2712_GPIO_PINS);
+	*pins = BCM2712_GPIO_PINS;
 
 	return 0;
 }
@@ -622,8 +831,8 @@
 {
 	VERBOSE("%s: %u\n", __func__, func_id);
 
-	*num_groups = ARRAY_SIZE(bcm2712_c0_gpio_pins);
-	*groups = bcm2712_c0_gpio_funcs_groups;
+	*num_groups = ARRAY_SIZE(BCM2712_GPIO_PINS);
+	*groups = BCM2712_FUNCS_GROUPS;
 
 	return 0;
 }
--- a/plat/rpi/rpi5/platform.mk
+++ b/plat/rpi/rpi5/platform.mk
@@ -116,6 +116,20 @@
 $(eval $(call add_define,RPI_SCMI_SHMEM_BASE))
 $(eval $(call add_define,RPI_SCMI_SHMEM_SIZE))
 $(eval $(call add_define_val,SCMI_NUM_AGENTS,${RPI_SCMI_NUM_AGENTS}))
+
+# BCM2712 stepping for the pin controller register tables. The C0 and D0 steppings
+# are NOT register-compatible for this block -- D0 shrinks it from 0x30 to 0x20 and
+# moves both the mux and the pad registers. 0 on D0 silicon hangs the CPU that
+# issues an SCMI pad request (it lands past the end of the block); 1 on C0
+# silicon programs the wrong pins. Default 0 (C0) keeps the previous behaviour;
+# a platform integrator that knows the silicon is D0 passes RPI5_PINCTRL_D0=1.
+RPI5_PINCTRL_D0 ?= 0
+$(eval $(call add_define_val,RPI5_PINCTRL_D0,${RPI5_PINCTRL_D0}))
+
+# Report EL3 exceptions instead of spinning silently. Not a debug-only nicety on
+# this platform: the console belongs to the hypervisor, so a faulting EL3 access
+# otherwise shows up only as a guest CPU that stops answering interrupts.
+CRASH_REPORTING		:= 1
 endif
 
 $(eval $(call add_define,RPI3_BL33_IN_AARCH32))
